+/* PS5 asynchronous present. The software frame is handed to a present
+ * thread that scales it straight into the scan-out buffer, tiles it, flips
+ * and waits for vblank (SDL_PS5_PresentPixels, psxrecomp patch to the PS5
+ * SDL2 video driver), while the emulator thread goes on to the next frame.
+ * B7 log: game 15.4 ms + SDL renderer scale/blend 13.3 ms + wait, run in
+ * series = every other vblank = 30 fps. In parallel the frame costs the
+ * larger of the two, not the sum. Latest frame wins; a stale pending frame
+ * is replaced, never queued. */
+extern "C" int SDL_PS5_PresentPixels(const Uint32 *argb, int w, int h, int pitch_px,
+                                     int dx, int dy, int dw, int dh);
+extern "C" void SDL_PS5_TakePresentStats(Uint64 *frames, double *blit_ms, double *wait_ms,
+                                         int *w, int *h);
+extern "C" double SDL_PS5_TakeScaleMs(void);
+extern "C" {
+typedef struct SDL_PS5_Overlay {
+    const Uint32 *argb;
+    int w, h;
+    int dx, dy, dw, dh;
+} SDL_PS5_Overlay;
+int SDL_PS5_PresentPixelsOverlay(const Uint32 *argb, int w, int h, int pitch_px,
+                                 int dx, int dy, int dw, int dh,
+                                 const SDL_PS5_Overlay *ov, int nov);
+}
+
+struct Ps5PresentQueue {
+    std::mutex m;
+    std::condition_variable cv;
+    std::vector<uint32_t> pending, work;
+    int w = 0, h = 0;
+    SDL_Rect dst{};
+    /* OSD images (message text, volume bar) with their screen rectangles. */
+    std::vector<uint32_t> osd_pending[2], osd_work[2];
+    SDL_PS5_Overlay ov_pending[2]{}, ov_work[2]{};
+    int nov_pending = 0;
+    bool have = false;
+    bool started = false;
+    uint64_t submitted = 0, replaced = 0, failed = 0;
+};
+static Ps5PresentQueue g_ps5q;
+
+static void ps5_present_thread_main(void)
+{
+    for (;;) {
+        int w, h, nov;
+        SDL_Rect d;
+        {
+            std::unique_lock<std::mutex> lk(g_ps5q.m);
+            g_ps5q.cv.wait(lk, [] { return g_ps5q.have; });
+            std::swap(g_ps5q.pending, g_ps5q.work);
+            w = g_ps5q.w;
+            h = g_ps5q.h;
+            d = g_ps5q.dst;
+            nov = g_ps5q.nov_pending;
+            for (int i = 0; i < nov; i++) {
+                std::swap(g_ps5q.osd_pending[i], g_ps5q.osd_work[i]);
+                g_ps5q.ov_work[i] = g_ps5q.ov_pending[i];
+                g_ps5q.ov_work[i].argb = g_ps5q.osd_work[i].data();
+            }
+            g_ps5q.have = false;
+        }
+        if (SDL_PS5_PresentPixelsOverlay(g_ps5q.work.data(), w, h, w, d.x, d.y, d.w, d.h,
+                                         g_ps5q.ov_work, nov) != 0)
+            g_ps5q.failed++;
+    }
+}
+
+extern "C" SDL_Window* sdl_window;   /* defined below (file scope) */
+
+/* dst is in the renderer's logical space (logical_w x logical_h); map it onto
+ * the window with the same aspect fit SDL's logical size would apply. */
+static bool ps5_present_submit(const uint32_t *px, int w, int h, const SDL_Rect &dst,
+                               int logical_w, int logical_h)
+{
+    if (!sdl_window || !px || w <= 0 || h <= 0 || logical_w <= 0 || logical_h <= 0)
+        return false;
+    int ww = 0, wh = 0;
+    SDL_GetWindowSize(sdl_window, &ww, &wh);
+    if (ww <= 0 || wh <= 0) return false;
+    const double f = std::min((double)ww / logical_w, (double)wh / logical_h);
+    const double ox = (ww - logical_w * f) / 2.0, oy = (wh - logical_h * f) / 2.0;
+    SDL_Rect d;
+    d.x = (int)std::lround(ox + dst.x * f);
+    d.y = (int)std::lround(oy + dst.y * f);
+    d.w = (int)std::lround(dst.w * f);
+    d.h = (int)std::lround(dst.h * f);
+    if (!g_ps5q.started) {
+        g_ps5q.started = true;
+        std::thread(ps5_present_thread_main).detach();
+        std::fprintf(stderr, "[ps5] async present thread started (%dx%d -> %d,%d %dx%d)\n",
+                     w, h, d.x, d.y, d.w, d.h);
+    }
+    /* On-screen messages, placed as host_osd_draw_sdl() places them in the
+     * logical space (text top-left, volume bar right-centre), then mapped to
+     * the screen like the frame. */
+    struct OsdImg { const uint32_t *px; int w, h; SDL_Rect r; };
+    OsdImg osd[2];
+    int nosd = 0;
+    {
+        const int ui = std::max(1, std::min(8, logical_h / 480));
+        const int margin = 8 * ui;
+        const uint32_t *opx = nullptr;
+        int ow = 0, oh = 0;
+        auto to_screen = [&](int lx, int ly, int lw2, int lh2) {
+            SDL_Rect r;
+            r.x = (int)std::lround(ox + lx * f);
+            r.y = (int)std::lround(oy + ly * f);
+            r.w = (int)std::lround(lw2 * f);
+            r.h = (int)std::lround(lh2 * f);
+            return r;
+        };
+        if (host_osd_image(&opx, &ow, &oh) && opx && ow > 0 && oh > 0)
+            osd[nosd++] = {opx, ow, oh, to_screen(margin, margin, ow * ui, oh * ui)};
+        if (host_osd_volume_image(&opx, &ow, &oh) && opx && ow > 0 && oh > 0) {
+            const int dw2 = ow * ui, dh2 = oh * ui;
+            const int vx = (logical_w > dw2 + margin) ? (logical_w - dw2 - margin) : margin;
+            const int vy = (logical_h > dh2) ? ((logical_h - dh2) / 2) : margin;
+            osd[nosd++] = {opx, ow, oh, to_screen(vx, vy, dw2, dh2)};
+        }
+        host_osd_present_done();
+    }
+    {
+        std::lock_guard<std::mutex> lk(g_ps5q.m);
+        if (g_ps5q.have) g_ps5q.replaced++;
+        g_ps5q.pending.assign(px, px + (size_t)w * h);
+        g_ps5q.w = w;
+        g_ps5q.h = h;
+        g_ps5q.dst = d;
+        g_ps5q.nov_pending = nosd;
+        for (int i = 0; i < nosd; i++) {
+            g_ps5q.osd_pending[i].assign(osd[i].px, osd[i].px + (size_t)osd[i].w * osd[i].h);
+            g_ps5q.ov_pending[i] = SDL_PS5_Overlay{nullptr, osd[i].w, osd[i].h,
+                                                   osd[i].r.x, osd[i].r.y, osd[i].r.w, osd[i].r.h};
+        }
+        g_ps5q.have = true;
+        g_ps5q.submitted++;
+    }
+    g_ps5q.cv.notify_one();
+    return true;
+}
+
+/* Frame-time breakdown for the PS5 log, every 5 s. */
+static Uint64 s_ps5_report_t0 = 0;
+static uint64_t s_ps5_report_vblanks = 0;
+static void ps5_frame_report(void)
+{
+    const Uint64 now = SDL_GetPerformanceCounter(), freq = SDL_GetPerformanceFrequency();
+    s_ps5_report_vblanks++;
+    if (!s_ps5_report_t0) { s_ps5_report_t0 = now; return; }
+    const double wall_ms = (double)(now - s_ps5_report_t0) * 1000.0 / (double)freq;
+    if (wall_ms < 5000.0) return;
+    const double scale_ms = SDL_PS5_TakeScaleMs();
+    Uint64 shown = 0;
+    double blit_ms = 0, wait_ms = 0;
+    int w = 0, h = 0;
+    SDL_PS5_TakePresentStats(&shown, &blit_ms, &wait_ms, &w, &h);
+    const double dn = shown ? (double)shown : 1.0;
+    uint64_t submitted, replaced, failed;
+    {
+        std::lock_guard<std::mutex> lk(g_ps5q.m);
+        submitted = g_ps5q.submitted;
+        replaced = g_ps5q.replaced;
+        failed = g_ps5q.failed;
+        g_ps5q.submitted = g_ps5q.replaced = g_ps5q.failed = 0;
+    }
+    std::fprintf(stderr,
+        "[ps5] 5s: emulator %.1f frames/s (%.2f ms each) | shown %.1f/s: scale %.2f + tiled %.2f + "
+        "vblank wait %.2f ms | submitted %llu, replaced %llu, failed %llu | %dx%d\n",
+        s_ps5_report_vblanks * 1000.0 / wall_ms, wall_ms / (double)s_ps5_report_vblanks,
+        shown * 1000.0 / wall_ms, scale_ms / dn, blit_ms / dn, wait_ms / dn,
+        (unsigned long long)submitted, (unsigned long long)replaced,
+        (unsigned long long)failed, w, h);
+    s_ps5_report_vblanks = 0;
+    s_ps5_report_t0 = now;
+}
+static void ps5_note_present(Uint64, Uint64) {}
