+/* PS5 (DualSense through the PS5 SDL2 port). No touch overlay or menu here,
+ * so the controller itself carries what Android's on-screen pad does:
+ *   - Sony Mouse titles (port 1 = mouse): touchpad = absolute pointer (finger
+ *     position = cursor position, steered via game.toml mouse_cursor) and
+ *     touchpad click = click there; sticks move the cursor; D-pad
+ *     steps it (Android's tap/repeat rule); Cross = left, Circle = right.
+ *   - Options held as a modifier: + L1 / R1 = insert disc 1 / disc 2,
+ *     + Square / Triangle = save / load state slot 1, + L3 = FPS readout.
+ *     Settings: <data>/ps5_controls.ini.
+ * The disc roster is filled at boot by the same code as Android's. */
+static std::vector<std::string> g_disc_swap_paths;
+static std::atomic<int> g_android_disc_count{0};
+static std::atomic<int> g_android_disc_current{0};
+static std::atomic<int> g_android_disc_swap_request{0};
