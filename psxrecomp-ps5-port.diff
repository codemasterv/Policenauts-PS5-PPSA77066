+/* SDL's PS5 driver reads (and so fills SDL_PS5_GetPadExtra for) only pads
+ * someone has opened. With port 1 a Sony Mouse the runtime opens none
+ * (PPSA77066 B6: no input at all), so hold our own controller handle. */
+static SDL_GameController *ps5_controller(void)
+{
+    static SDL_GameController *gc = nullptr;
+    static SDL_Joystick *js = nullptr;
+    if (gc && SDL_GameControllerGetAttached(gc)) return gc;
+    if (js && !gc && SDL_JoystickGetAttached(js)) return nullptr;
+    if (gc) { SDL_GameControllerClose(gc); gc = nullptr; }
+    if (js) { SDL_JoystickClose(js); js = nullptr; }
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        if (SDL_IsGameController(i) && (gc = SDL_GameControllerOpen(i)) != nullptr) {
+            std::fprintf(stderr, "[ps5] opened controller %d: %s\n", i,
+                         SDL_GameControllerName(gc) ? SDL_GameControllerName(gc) : "?");
+            return gc;
+        }
+        if ((js = SDL_JoystickOpen(i)) != nullptr) {
+            std::fprintf(stderr, "[ps5] opened joystick %d (no controller mapping): %s\n", i,
+                         SDL_JoystickName(js) ? SDL_JoystickName(js) : "?");
+            return nullptr;
+        }
+    }
+    return nullptr;
+}
+
+/* Raw pad if the patched driver has it, else rebuilt from SDL's controller
+ * API (no touchpad/gyro then). */
+static bool ps5_read_pad(SDL_PS5_PadExtra &pad, int *source)
+{
+    SDL_GameController *gc = ps5_controller();
+    pad = SDL_PS5_PadExtra{};
+    if (SDL_PS5_GetPadExtra(0, &pad) == 0 && pad.connected) {
+        *source = 1;
+        return true;
+    }
+    if (!gc) {
+        *source = 0;
+        return false;
+    }
+    pad = SDL_PS5_PadExtra{};
+    pad.connected = 1;
+    struct { SDL_GameControllerButton sb; uint32_t bit; } map[] = {
+        {SDL_CONTROLLER_BUTTON_A, PS5B_CROSS}, {SDL_CONTROLLER_BUTTON_B, PS5B_CIRCLE},
+        {SDL_CONTROLLER_BUTTON_X, PS5B_SQUARE}, {SDL_CONTROLLER_BUTTON_Y, PS5B_TRIANGLE},
+        {SDL_CONTROLLER_BUTTON_LEFTSHOULDER, PS5B_L1}, {SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, PS5B_R1},
+        {SDL_CONTROLLER_BUTTON_LEFTSTICK, PS5B_L3}, {SDL_CONTROLLER_BUTTON_RIGHTSTICK, PS5B_R3},
+        {SDL_CONTROLLER_BUTTON_START, PS5B_OPTIONS}, {SDL_CONTROLLER_BUTTON_TOUCHPAD, PS5B_TOUCHPAD},
+        {SDL_CONTROLLER_BUTTON_DPAD_UP, PS5B_UP}, {SDL_CONTROLLER_BUTTON_DPAD_DOWN, PS5B_DOWN},
+        {SDL_CONTROLLER_BUTTON_DPAD_LEFT, PS5B_LEFT}, {SDL_CONTROLLER_BUTTON_DPAD_RIGHT, PS5B_RIGHT},
+    };
+    for (const auto &m : map)
+        if (SDL_GameControllerGetButton(gc, m.sb)) pad.buttons |= m.bit;
+    auto ax = [gc](SDL_GameControllerAxis a) {
+        return (Uint8)std::clamp(128 + SDL_GameControllerGetAxis(gc, a) / 256, 0, 255);
+    };
+    pad.lx = ax(SDL_CONTROLLER_AXIS_LEFTX);
+    pad.ly = ax(SDL_CONTROLLER_AXIS_LEFTY);
+    pad.rx = ax(SDL_CONTROLLER_AXIS_RIGHTX);
+    pad.ry = ax(SDL_CONTROLLER_AXIS_RIGHTY);
+    *source = 2;
+    return true;
+}
