+/* <data>/ps5_controls.ini (created with defaults on first launch). */
+struct Ps5Controls {
+    float stick_speed = 1.0f;
+    bool touch_pointer = true;
+    /* game.toml [controller] mouse_cursor: where the game keeps its cursor. */
+    bool cursor_known = false;
+    int area_w = 320, area_h = 240;
+    int touch_w = 1920, touch_h = 1080;   /* grows if larger coordinates are seen */
+    bool usb_mouse = true;
+    float usb_mouse_speed = 1.0f;
+};
+static Ps5Controls g_ps5c;
+
+static bool ps5_ini_bool(const char *v) {
+    return !(std::strncmp(v, "off", 3) == 0 || std::strncmp(v, "0", 1) == 0 ||
+             std::strncmp(v, "false", 5) == 0 || std::strncmp(v, "no", 2) == 0);
+}
+
+static void ps5_controls_load(void)
+{
+    static const char *kDefaults =
+        "# PS5 controls for this game. Edit, then restart the game.\n"
+        "# sticks and D-pad move the cursor too; stick_speed scales the sticks.\n"
+        "stick_speed = 1.0\n"
+        "# touch_pointer: where your finger is on the touchpad is where the\n"
+        "# cursor goes on screen; clicking the touchpad clicks there.\n"
+        "touch_pointer = on\n"
+        "# usb_mouse: a USB or Bluetooth mouse moves the cursor and clicks;\n"
+        "# usb_mouse_speed scales it (0.5 = half as fast).\n"
+        "usb_mouse = on\n"
+        "usb_mouse_speed = 1.0\n";
+    FILE *f = std::fopen("ps5_controls.ini", "r");
+    if (!f) {
+        if (FILE *w = std::fopen("ps5_controls.ini", "w")) {
+            std::fputs(kDefaults, w);
+            std::fclose(w);
+        }
+        f = std::fopen("ps5_controls.ini", "r");
+    }
+    char line[256];
+    while (f && std::fgets(line, sizeof(line), f)) {
+        char key[64], val[64];
+        if (line[0] == '#' || std::sscanf(line, " %63[a-z_] = %63s", key, val) != 2) continue;
+        if (!std::strcmp(key, "stick_speed")) g_ps5c.stick_speed = (float)std::atof(val);
+        else if (!std::strcmp(key, "touch_pointer")) g_ps5c.touch_pointer = ps5_ini_bool(val);
+        else if (!std::strcmp(key, "usb_mouse")) g_ps5c.usb_mouse = ps5_ini_bool(val);
+        else if (!std::strcmp(key, "usb_mouse_speed")) g_ps5c.usb_mouse_speed = (float)std::atof(val);
+    }
+    if (f) std::fclose(f);
+
+    /* mouse_cursor = "0xXADDR,0xYADDR,W,H" (the Android overlay passes the same
+     * value through JNI): lets the touch pointer steer the game's real cursor. */
+    if (FILE *g = std::fopen("game.toml", "r")) {
+        while (std::fgets(line, sizeof(line), g)) {
+            unsigned xa = 0, ya = 0;
+            int w = 0, h = 0;
+            const char *k = std::strstr(line, "mouse_cursor");
+            if (!k || line[0] == '#') continue;
+            const char *q = std::strchr(k, '"');
+            if (q && std::sscanf(q + 1, "%x , %x , %d , %d", &xa, &ya, &w, &h) == 4 &&
+                xa && ya && w > 0 && h > 0) {
+                sio_mouse_cursor_addr(xa, ya);
+                g_ps5c.cursor_known = true;
+                g_ps5c.area_w = w;
+                g_ps5c.area_h = h;
+            }
+        }
+        std::fclose(g);
+    }
+    std::fprintf(stderr, "[ps5] controls: stick_speed=%.2f touch_pointer=%d usb_mouse=%d (%.2f) cursor=%s (%dx%d)\n",
+                 g_ps5c.stick_speed, g_ps5c.touch_pointer, g_ps5c.usb_mouse, g_ps5c.usb_mouse_speed,
+                 g_ps5c.cursor_known ? "known" : "unknown", g_ps5c.area_w, g_ps5c.area_h);
+}
