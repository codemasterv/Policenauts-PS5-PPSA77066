+/* Raw DualSense state from the PS5 SDL2 port (psxrecomp patch to
+ * src/joystick/ps5/SDL_ps5joystick.c): buttons, sticks, touchpad fingers and
+ * gyro, independent of SDL's controller-mapping layer. */
+extern "C" {
+typedef struct SDL_PS5_PadExtra {
+    int connected;
+    Uint32 buttons;
+    int fingers;
+    int tx[2], ty[2];
+    int tid[2];
+    float gyro[3];
