+enum : uint32_t {
+    PS5B_L3 = 0x0002, PS5B_R3 = 0x0004, PS5B_OPTIONS = 0x0008,
+    PS5B_UP = 0x0010, PS5B_RIGHT = 0x0020, PS5B_DOWN = 0x0040, PS5B_LEFT = 0x0080,
+    PS5B_L2 = 0x0100, PS5B_R2 = 0x0200, PS5B_L1 = 0x0400, PS5B_R1 = 0x0800,
+    PS5B_TRIANGLE = 0x1000, PS5B_CIRCLE = 0x2000, PS5B_CROSS = 0x4000,
+    PS5B_SQUARE = 0x8000, PS5B_TOUCHPAD = 0x100000,
+};
