+/* USB / Bluetooth mouse through the system's libSceMouse, with the
+ * mousebridge payload's help (~/work/mousebridge).
+ *
+ * The title can load libSceMouse.sprx from the sandbox, but a fake-signed
+ * title cannot look up its functions: sceKernelDlsym -> 0x80020003 for every
+ * name/NID (B12) and imports bind to NULL (B13). So the game loads the module,
+ * fills a mailbox in its own memory and leaves a request file in
+ * /data/mousebridge/; the resident mousebridge payload resolves the functions
+ * inside this process with kernel access and writes their addresses into the
+ * mailbox (raising the process's caps/authid on a retry request if the open
+ * fails). The game polls the mailbox once a frame, so the payload can be sent
+ * before or after the game starts. Layout/ABI as in the PS4 SDK headers. */
+#include <dirent.h>
+#include <sys/stat.h>
+#include <unistd.h>
+extern "C" {
+int32_t sceKernelLoadStartModule(const char *path, size_t argc, const void *argv,
+                                 uint32_t flags, void *opt, int *res);
+const char *sceKernelGetFsSandboxRandomWord(void);
+int32_t sceUserServiceGetInitialUser(int32_t *user);
+int32_t sceUserServiceGetForegroundUser(int32_t *user);
+}
+struct Ps5MouseData {
+    uint64_t timestamp;
+    bool connected;
+    uint32_t buttons;
+    int32_t x, y, wheel, tilt;
+    uint8_t reserve[8];
+};
+/* Same layout as struct mb_mailbox in mousebridge/main.c. */
+struct Ps5MouseMailbox {
+    uint64_t magic;
+    uint64_t fn[5];   /* init, open, read, close, setProcessPrivilege */
+    int32_t status;   /* 0 waiting, >0 done (elevation + 1), <0 failed */
+    int32_t pad;
+};
+static constexpr uint64_t kMouseMailboxMagic = 0x3152424553554F4DULL;   /* "MOUSEBR1" */
+alignas(64) static volatile Ps5MouseMailbox g_mouse_mb;
+
+struct Ps5HidMouse {
+    enum { kOff, kWaiting, kReady } state = kOff;
+    bool ok = false, connected = false, left = false, right = false;
+    int module = -1, handle = -1, elevate = 0, wait_frames = 0;
+    int32_t (*read)(int32_t, Ps5MouseData *, int32_t) = nullptr;
+    float carry_x = 0.0f, carry_y = 0.0f;
+    int moved_x = 0, moved_y = 0, clicks = 0;
+};
+static Ps5HidMouse g_hid;
+
+static void ps5_mouse_request(int elevate)
+{
+    g_mouse_mb.status = 0;
+    mkdir("/data/mousebridge", 0777);
+    char path[96], tmp[100];
+    std::snprintf(path, sizeof(path), "/data/mousebridge/request-%d.txt", (int)getpid());
+    std::snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+    FILE *f = std::fopen(tmp, "w");
+    if (!f) {
+        std::fprintf(stderr, "[ps5] usb mouse: cannot write %s: %s\n", tmp, std::strerror(errno));
+        g_hid.state = Ps5HidMouse::kOff;
+        return;
+    }
+    std::fprintf(f, "%d %u %llx %d\n", (int)getpid(), (unsigned)g_hid.module,
+                 (unsigned long long)(uintptr_t)&g_mouse_mb, elevate);
+    std::fclose(f);
+    std::rename(tmp, path);   /* the bridge only picks up complete files */
+    g_hid.elevate = elevate;
+    g_hid.wait_frames = 0;
+    g_hid.state = Ps5HidMouse::kWaiting;
+    std::fprintf(stderr, "[ps5] usb mouse: request (elevate %d) waiting for mousebridge\n", elevate);
+}
+
+static void ps5_hid_mouse_open(void)
+{
+    const char *word = sceKernelGetFsSandboxRandomWord();
+    char path[160];
+    std::snprintf(path, sizeof(path), "/%s/common/lib/libSceMouse.sprx", word ? word : "system");
+    int res = 0;
+    const int mod = sceKernelLoadStartModule(path, 0, nullptr, 0, nullptr, &res);
+    std::fprintf(stderr, "[ps5] usb mouse: load %s -> 0x%x\n", path, (unsigned)mod);
+    if (mod < 0) return;
+    g_hid.module = mod;
+    g_mouse_mb.magic = kMouseMailboxMagic;
+    ps5_mouse_request(0);
+}
+
+/* Once a frame: has the bridge answered? Then open the mouse; if the open is
+ * refused, ask the bridge for more privilege and try again (up to authid). */
+static void ps5_hid_mouse_step(void)
+{
+    if (g_hid.state != Ps5HidMouse::kWaiting) return;
+    const int32_t st = g_mouse_mb.status;
+    if (st == 0) {
+        if (++g_hid.wait_frames == 600 && g_hid.elevate == 0)
+            std::fprintf(stderr, "[ps5] usb mouse: no answer yet - send mousebridge.elf to "
+                                 "port 9021 (the game keeps waiting)\n");
+        return;
+    }
+    if (st < 0) {
+        std::fprintf(stderr, "[ps5] usb mouse: bridge could not resolve libSceMouse; mouse off\n");
+        g_hid.state = Ps5HidMouse::kOff;
+        return;
+    }
+    auto init = reinterpret_cast<int32_t (*)(void)>(g_mouse_mb.fn[0]);
+    auto open = reinterpret_cast<int32_t (*)(int32_t, int32_t, int32_t, void *)>(g_mouse_mb.fn[1]);
+    auto priv = reinterpret_cast<int32_t (*)(int32_t)>(g_mouse_mb.fn[4]);
+    const int ir = init();
+    int32_t user = -1;
+    if (sceUserServiceGetForegroundUser(&user) != 0 || user < 0)
+        sceUserServiceGetInitialUser(&user);
+    uint8_t param[8] = {0};   /* SceMouseOpenParam: behaviorFlag 0 = merged */
+    int h = open(user, 0, 0, param);
+    std::fprintf(stderr, "[ps5] usb mouse: bridged (status %d): init -> 0x%x, open(user 0x%x) -> 0x%x\n",
+                 (int)st, (unsigned)ir, (unsigned)user, (unsigned)h);
+    if (h < 0 && priv) {
+        const int pr = priv(1);
+        h = open(user, 0, 0, param);
+        std::fprintf(stderr, "[ps5] usb mouse: privilege -> 0x%x, open again -> 0x%x\n",
+                     (unsigned)pr, (unsigned)h);
+    }
+    if (h < 0) {
+        if (g_hid.elevate < 2) ps5_mouse_request(g_hid.elevate + 1);
+        else {
+            std::fprintf(stderr, "[ps5] usb mouse: open refused even with full privilege; mouse off\n");
+            g_hid.state = Ps5HidMouse::kOff;
+        }
+        return;
+    }
+    g_hid.handle = h;
+    g_hid.read = reinterpret_cast<int32_t (*)(int32_t, Ps5MouseData *, int32_t)>(g_mouse_mb.fn[2]);
+    g_hid.ok = true;
+    g_hid.state = Ps5HidMouse::kReady;
+    host_osd_push("USB mouse ready", 2000);
+}
+
+/* Poll the mouse; moves the PS1 mouse directly. Buttons land in g_hid. */
+static void ps5_hid_mouse_poll(int port1_mouse, float speed)
+{
+    if (!g_hid.ok) return;
+    Ps5MouseData d[8];
+    std::memset(d, 0, sizeof(d));
+    const int n = g_hid.read(g_hid.handle, d, 8);
+    if (n <= 0) return;
+    int sx = 0, sy = 0;
+    for (int i = 0; i < n && i < 8; i++) {
+        sx += d[i].x;
+        sy += d[i].y;
+    }
+    const Ps5MouseData &last = d[(n < 8 ? n : 8) - 1];
+    if (last.connected != g_hid.connected) {
+        g_hid.connected = last.connected;
+        std::fprintf(stderr, "[ps5] usb mouse %s\n", last.connected ? "connected" : "disconnected");
+        if (last.connected) host_osd_push("USB mouse connected", 2000);
+    }
+    /* First samples with anything in them, raw, in case the layout differs. */
+    static int dumps = 0;
+    if (dumps < 4 && (sx || sy || last.buttons)) {
+        dumps++;
+        const uint8_t *r = reinterpret_cast<const uint8_t *>(&d[0]);
+        char hex[3 * 40 + 1];
+        int k = 0;
+        for (int i = 0; i < 40; i++) k += std::snprintf(hex + k, sizeof(hex) - k, "%02x ", r[i]);
+        std::fprintf(stderr, "[ps5] usb mouse sample n=%d dx=%d dy=%d buttons=%x raw=%s\n",
+                     n, sx, sy, (unsigned)last.buttons, hex);
+    }
+    const bool l = (last.buttons & 1) != 0, r = (last.buttons & 2) != 0;
+    if (l && !g_hid.left) g_hid.clicks++;
+    g_hid.left = l;
+    g_hid.right = r;
+    if (!port1_mouse) return;
+    /* PC mice report far more counts than the PS1 mouse; halve, then scale. */
+    g_hid.carry_x += sx * 0.5f * speed;
+    g_hid.carry_y += sy * 0.5f * speed;
+    const int dx = (int)g_hid.carry_x, dy = (int)g_hid.carry_y;
+    g_hid.carry_x -= dx;
+    g_hid.carry_y -= dy;
+    if (dx || dy) {
+        sio_set_mouse_motion(dx, dy);
+        g_hid.moved_x += dx;
+        g_hid.moved_y += dy;
+    }
+}
+
+/* Called once per VBlank on the emulator thread. */
+static void ps5_controller_frame(int port1_mouse)
+{
+    static bool inited = false;
+    if (!inited) {
+        inited = true;
+        ps5_controls_load();
+        if (g_ps5c.usb_mouse) ps5_hid_mouse_open();
+    }
+    ps5_frame_report();
+    ps5_hid_mouse_step();
+    ps5_hid_mouse_poll(port1_mouse, g_ps5c.usb_mouse_speed);
+    {
+        static int hid_frames = 0;
+        if (g_hid.ok && ++hid_frames >= 300) {
+            if (g_hid.moved_x || g_hid.moved_y || g_hid.clicks)
+                std::fprintf(stderr, "[ps5] usb mouse 5s: motion %+d,%+d  clicks %d\n",
+                             g_hid.moved_x, g_hid.moved_y, g_hid.clicks);
+            g_hid.moved_x = g_hid.moved_y = g_hid.clicks = hid_frames = 0;
+        }
+    }
+    SDL_PS5_PadExtra pad{};
+    int source = 0;
+    const bool have = ps5_read_pad(pad, &source);
+    static int last_source = -1;
+    if (source != last_source) {
+        static const char *names[] = {"none", "raw DualSense (touchpad+gyro)", "SDL controller (no touchpad/gyro)"};
+        std::fprintf(stderr, "[ps5] controller input: %s (SDL sees %d joystick(s))\n",
+                     names[source], SDL_NumJoysticks());
+        last_source = source;
+    }
+    /* First 10 s of input: one state line per second, to see what arrives. */
+    static int diag_frames = 0;
+    if (have && diag_frames < 600 && (++diag_frames % 60) == 0)
+        std::fprintf(stderr, "[ps5] pad: buttons=%06x L=%d,%d R=%d,%d fingers=%d touch=%d,%d\n",
+                     (unsigned)pad.buttons, pad.lx, pad.ly, pad.rx, pad.ry, pad.fingers,
+                     pad.tx[0], pad.ty[0]);
+    /* Touchpad click = a finger is on the pad: dump the raw state the first
+     * few times, to check where the PS5 keeps the touch coordinates (B7 never
+     * saw a finger). */
+    {
+        static bool prev_click = false;
+        static int dumps = 0;
+        const bool click = have && (pad.buttons & PS5B_TOUCHPAD);
+        if (click && !prev_click && dumps < 6 && source == 1) {
+            dumps++;
+            char hex[3 * 128 + 1];
+            int n = 0;
+            for (int i = 0; i < pad.raw_size && i < 128; i++)
+                n += std::snprintf(hex + n, sizeof(hex) - n, "%02x%s", pad.raw[i],
+                                   (i % 16 == 15) ? "|" : " ");
+            std::fprintf(stderr, "[ps5] touch press: fingers=%d xy=%d,%d raw(%d)=%s\n",
+                         pad.fingers, pad.tx[0], pad.ty[0], pad.raw_size, hex);
+        }
+        prev_click = click;
+    }
+    if (!have) {
+        /* No controller: the USB mouse alone still clicks. */
+        static bool pl, pr;
+        if (port1_mouse && (g_hid.left != pl || g_hid.right != pr))
+            sio_set_mouse_buttons(g_hid.left, g_hid.right);
+        pl = g_hid.left;
+        pr = g_hid.right;
+        return;
+    }
+    const uint32_t b = pad.buttons;
+    const bool opt = (b & PS5B_OPTIONS) != 0;
+
+    /* Options-held shortcuts: once per press, then a second's rest (B3 fired
+     * twice per press when the modifier dropped out for a frame). */
+    enum { kL1, kR1, kSq, kTri, kL3, kCombos };
+    static const uint32_t combo_bit[kCombos] = {
+        PS5B_L1, PS5B_R1, PS5B_SQUARE, PS5B_TRIANGLE, PS5B_L3};
+    static bool prev[kCombos];
+    static int cooldown[kCombos];
+    for (int i = 0; i < kCombos; i++) {
+        const bool now = opt && (b & combo_bit[i]);
+        if (cooldown[i] > 0) cooldown[i]--;
+        const bool fire = now && !prev[i] && cooldown[i] == 0;
+        prev[i] = now;
+        if (!fire) continue;
+        cooldown[i] = 60;
+        switch (i) {
+        case kL1: ps5_apply_disc_swap(1); break;
+        case kR1: ps5_apply_disc_swap(2); break;
+        case kSq:
+            if (!savestate_request_save(0)) host_osd_push("Save state not available", 2500);
+            break;
+        case kTri:
+            if (!savestate_request_load(0)) host_osd_push("Load state not available", 2500);
+            break;
+        case kL3: fps_telemetry_toggle(); break;
+        }
+    }
+    if (!port1_mouse) return;
+
+    static int motion_x = 0, motion_y = 0, clicks = 0, touches = 0, frames = 0;
+
+    /* Buttons: Cross / touchpad click = left, Circle = right. Not while
+     * Options is held (shortcuts). A touchpad click with the touch pointer
+     * steering is delivered as a click on arrival (sio_mouse_point). */
+    const bool touching = g_ps5c.touch_pointer && pad.fingers > 0;
+    const bool steer_click = touching && g_ps5c.cursor_known;
+    static bool prev_left, prev_right, prev_touch_click;
+    const bool touch_click = !opt && (b & PS5B_TOUCHPAD);
+    const bool left = g_hid.left || (!opt && ((b & PS5B_CROSS) || (touch_click && !steer_click)));
+    const bool right = g_hid.right || (!opt && (b & PS5B_CIRCLE));
+    if (left != prev_left || right != prev_right) {
+        sio_set_mouse_buttons(left, right);
+        if (left && !prev_left) clicks++;
+    }
+    prev_left = left;
+    prev_right = right;
+
+    /* Touch pointer: finger position on the pad = cursor position on screen. */
+    static int last_tx = -1, last_ty = -1, last_fx = -1, last_fy = -1;
+    if (touching && !opt) {
+        int fx = pad.tx[0], fy = pad.ty[0];
+        if (fx >= g_ps5c.touch_w) g_ps5c.touch_w = fx + 1;
+        if (fy >= g_ps5c.touch_h) g_ps5c.touch_h = fy + 1;
+        const int x = fx * g_ps5c.area_w / g_ps5c.touch_w;
+        const int y = fy * g_ps5c.area_h / g_ps5c.touch_h;
+        const bool click_edge = touch_click && !prev_touch_click;
+        if (g_ps5c.cursor_known) {
+            if (last_tx < 0 || std::abs(x - last_tx) >= 2 || std::abs(y - last_ty) >= 2 ||
+                click_edge) {
+                sio_mouse_point(x, y, click_edge ? 1 : 0, 0);
+                last_tx = x;
+                last_ty = y;
+                if (click_edge) clicks++;
+            }
+        } else if (last_fx >= 0) {
+            /* Cursor address unknown: behave like a laptop trackpad. */
+            const int dx = (fx - last_fx) * g_ps5c.area_w / g_ps5c.touch_w;
+            const int dy = (fy - last_fy) * g_ps5c.area_h / g_ps5c.touch_h;
+            if (dx || dy) {
+                sio_set_mouse_motion(dx, dy);
+                motion_x += dx;
+                motion_y += dy;
+            }
+        }
+        last_fx = fx;
+        last_fy = fy;
+        if (last_tx < 0) touches++;
+    } else {
+        last_tx = last_ty = last_fx = last_fy = -1;
+    }
+    prev_touch_click = touch_click;
+    if (opt) return;
+
+    float mx = 0.0f, my = 0.0f;
+
+    /* Sticks (analog): radial deadzone, quadratic response, up to ~9 mouse
+     * counts per frame at full tilt. */
+    const uint8_t sticks[2][2] = {{pad.lx, pad.ly}, {pad.rx, pad.ry}};
+    for (const auto &st : sticks) {
+        const float x = ((int)st[0] - 128) / 127.0f;
+        const float y = ((int)st[1] - 128) / 127.0f;
+        const float mag = std::sqrt(x * x + y * y);
+        constexpr float kDead = 0.22f;
+        if (mag <= kDead) continue;
+        const float t = std::min(1.0f, (mag - kDead) / (1.0f - kDead));
+        const float speed = (1.0f + 8.0f * t * t) * g_ps5c.stick_speed;
+        mx += x / mag * speed;
+        my += y / mag * speed;
+    }
+
+    static float carry_x, carry_y;
+    carry_x += mx;
+    carry_y += my;
+    const int dx = (int)carry_x, dy = (int)carry_y;
+    carry_x -= dx;
+    carry_y -= dy;
+    if (mx == 0.0f) carry_x = 0.0f;
+    if (my == 0.0f) carry_y = 0.0f;
+
+    /* D-pad: one firm step on press, pause, then accelerating repeat. */
+    static constexpr int kTapStep = 20, kRepeatDelay = 15;
+    static int held_frames = 0, last_px = 0, last_py = 0;
+    const int px = ((b & PS5B_RIGHT) ? 1 : 0) - ((b & PS5B_LEFT) ? 1 : 0);
+    const int py = ((b & PS5B_DOWN) ? 1 : 0) - ((b & PS5B_UP) ? 1 : 0);
+    int step = 0;
+    if (px || py) {
+        if (px != last_px || py != last_py) held_frames = 0;
+        held_frames++;
+        if (held_frames == 1) step = kTapStep;
+        else if (held_frames <= kRepeatDelay) step = 0;
+        else if (held_frames <= kRepeatDelay + 30) step = 3;
+        else step = 6;
+    } else {
+        held_frames = 0;
+    }
+    last_px = px;
+    last_py = py;
+
+    const int tx = dx + px * step, ty = dy + py * step;
+    if (tx || ty) {
+        sio_set_mouse_motion(tx, ty);
+        motion_x += tx;
+        motion_y += ty;
+    }
+
+    /* Input diagnostics: one line per 5 s with activity. */
+    if (++frames >= 300) {
+        if (motion_x || motion_y || clicks || touches)
+            std::fprintf(stderr, "[ps5] mouse 5s: motion %+d,%+d  clicks %d  touches %d\n",
+                         motion_x, motion_y, clicks, touches);
+        motion_x = motion_y = clicks = touches = frames = 0;
+    }
+}
