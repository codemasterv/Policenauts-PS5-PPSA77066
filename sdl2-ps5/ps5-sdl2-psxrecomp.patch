+/* psxrecomp PS5 port: the raw DualSense touchpad and motion data that SDL's
+ * joystick API does not carry here, from the state the last
+ * SDL_JoystickUpdate() read. Index = n-th opened pad. Returns 0 on success. */
+typedef struct SDL_PS5_PadExtra
+{
+    int connected;
+    Uint32 buttons;        /* PS5_PAD_BUTTON_* bits */
+    int fingers;           /* 0..2 */
+    int tx[2], ty[2];      /* touch position, touchpad pixels */
+    int tid[2];            /* finger id */
+    float gyro[3];         /* angular velocity x/y/z, rad/s */
+    float accel[3];
+    Uint64 timestamp;
+    Uint8 lx, ly, rx, ry;  /* sticks, 0..255, 128 = centre */
+    Uint8 l2, r2;          /* analog triggers */
+    Uint8 raw[128];        /* the PS5_PadData bytes as read (layout checks) */
+    int raw_size;
+} SDL_PS5_PadExtra;
+
+DECLSPEC int SDLCALL SDL_PS5_GetPadExtra(int index, SDL_PS5_PadExtra *out)
+{
+    int i, n = 0;
+    if (!out) {
+        return -1;
+    }
+    SDL_zerop(out);
+    for (i = 0; i < PS5_MAX_USERS; i++) {
+        const PS5_PadData *p;
+        if (pad_ctx[i].handle < 0 || pad_ctx[i].instance_id == -1) {
+            continue;
+        }
+        if (n++ != index) {
+            continue;
+        }
+        p = &pad_ctx[i].pad;
+        out->connected = 1;
+        out->buttons = p->buttons;
+        out->fingers = p->touch.fingers > 2 ? 2 : p->touch.fingers;
+        for (int f = 0; f < out->fingers; f++) {
+            out->tx[f] = p->touch.touch[f].x;
+            out->ty[f] = p->touch.touch[f].y;
+            out->tid[f] = p->touch.touch[f].finger;
+        }
+        out->gyro[0] = p->vel.x;
+        out->gyro[1] = p->vel.y;
+        out->gyro[2] = p->vel.z;
+        out->accel[0] = p->acell.x;
+        out->accel[1] = p->acell.y;
+        out->accel[2] = p->acell.z;
+        out->timestamp = p->timestamp;
+        out->lx = p->leftStick.x;
+        out->ly = p->leftStick.y;
+        out->rx = p->rightStick.x;
+        out->ry = p->rightStick.y;
+        out->l2 = p->analogButtons.l2;
+        out->r2 = p->analogButtons.r2;
+        out->raw_size = (int)(sizeof(*p) < sizeof(out->raw) ? sizeof(*p) : sizeof(out->raw));
+        SDL_memcpy(out->raw, p, out->raw_size);
+        return 0;
+    }
+    return -1;
+}
+
 #endif /* SDL_JOYSTICK_PS5 */
 
