+/* psxrecomp PS5 port: present a game frame straight into the scan-out
+ * buffers, bypassing SDL's renderer: nearest-neighbour scale of an ARGB8888
+ * image (red/blue swapped on the fly) into dst (screen pixels), tiled blit of
+ * just that rectangle, flip, wait for the flip. Safe to call from a thread
+ * other than the one that owns the SDL renderer. Returns 0 on success. */
+/* An image composited over the frame after scaling (OSD text, volume bar):
+ * ARGB8888, nearest-scaled into dst (screen pixels); alpha 0 = transparent. */
+typedef struct SDL_PS5_Overlay
+{
+    const Uint32 *argb;
+    int w, h;
+    int dx, dy, dw, dh;
+} SDL_PS5_Overlay;
+
+static void PS5_DrawOverlay(SDL_Surface *surf, const SDL_PS5_Overlay *o)
+{
+    const int dpitch = surf->pitch / 4;
+    int x0 = o->dx, y0 = o->dy, x1 = o->dx + o->dw, y1 = o->dy + o->dh;
+    if (!o->argb || o->w <= 0 || o->h <= 0 || o->dw <= 0 || o->dh <= 0) {
+        return;
+    }
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > surf->w) x1 = surf->w;
+    if (y1 > surf->h) y1 = surf->h;
+    for (int y = y0; y < y1; y++) {
+        const Uint32 *srow = o->argb + (size_t)(((Sint64)(y - o->dy) * o->h) / o->dh) * o->w;
+        Uint32 *drow = (Uint32 *)surf->pixels + (size_t)y * dpitch;
+        for (int x = x0; x < x1; x++) {
+            const Uint32 p = srow[((Sint64)(x - o->dx) * o->w) / o->dw];
+            if ((p >> 24) == 0) {
+                continue;
+            }
+            drow[x] = (p & 0xFF00FF00u) | ((p >> 16) & 0xFFu) | ((p & 0xFFu) << 16);
+        }
+    }
+}
+
+static int PS5_PresentPixelsImpl(const Uint32 *argb, int w, int h, int pitch_px,
+                                 int dx, int dy, int dw, int dh,
+                                 const SDL_PS5_Overlay *ov, int nov);
+static int PS5_overlay_outside;
+
+DECLSPEC int SDLCALL SDL_PS5_PresentPixels(const Uint32 *argb, int w, int h, int pitch_px,
+                                           int dx, int dy, int dw, int dh)
+{
+    return PS5_PresentPixelsImpl(argb, w, h, pitch_px, dx, dy, dw, dh, NULL, 0);
+}
+
+DECLSPEC int SDLCALL SDL_PS5_PresentPixelsOverlay(const Uint32 *argb, int w, int h, int pitch_px,
+                                                  int dx, int dy, int dw, int dh,
+                                                  const SDL_PS5_Overlay *ov, int nov)
+{
+    return PS5_PresentPixelsImpl(argb, w, h, pitch_px, dx, dy, dw, dh, ov, nov);
+}
+
+static int PS5_PresentPixelsImpl(const Uint32 *argb, int w, int h, int pitch_px,
+                                 int dx, int dy, int dw, int dh,
+                                 const SDL_PS5_Overlay *ov, int nov)
+{
+    SDL_VideoDevice *dev = SDL_GetVideoDevice();
+    PS5_DeviceData *dd;
+    SDL_Surface *surf;
+    static int *xmap = NULL;
+    static int xmap_w = 0, xmap_dw = 0;
+    static SDL_Rect last = { 0, 0, 0, 0 };
+    SDL_Rect damage, full;
+    struct kevent evt;
+    int junk, y, idx;
+    Uint64 t0, t1, t2, t3;
+
+    if (!dev || !dev->driverdata || !argb || w <= 0 || h <= 0) {
+        return -1;
+    }
+    dd = (PS5_DeviceData *)dev->driverdata;
+    surf = dd->surface;
+    if (!surf) {
+        return -1;
+    }
+    full.x = 0; full.y = 0; full.w = surf->w; full.h = surf->h;
+    /* Clip the destination to the screen. */
+    if (dx < 0) { dw += dx; dx = 0; }
+    if (dy < 0) { dh += dy; dy = 0; }
+    if (dx + dw > surf->w) dw = surf->w - dx;
+    if (dy + dh > surf->h) dh = surf->h - dy;
+    if (dw <= 0 || dh <= 0) {
+        return -1;
+    }
+
+    t0 = SDL_GetPerformanceCounter();
+    PS5_PresentLock();
+    if (xmap_w != w || xmap_dw != dw) {
+        int *nx = (int *)SDL_realloc(xmap, sizeof(int) * dw);
+        if (!nx) {
+            PS5_PresentUnlock();
+            return -1;
+        }
+        xmap = nx;
+        for (int x = 0; x < dw; x++) {
+            xmap[x] = (int)(((Sint64)x * w) / dw);
+        }
+        xmap_w = w;
+        xmap_dw = dw;
+    }
+    if (last.x != dx || last.y != dy || last.w != dw || last.h != dh || PS5_overlay_outside) {
+        /* Geometry changed, or an overlay drew outside the frame last time:
+         * black out the whole screen once. */
+        PS5_overlay_outside = 0;
+        SDL_memset(surf->pixels, 0, (size_t)surf->pitch * surf->h);
+        damage = full;
+        last.x = dx; last.y = dy; last.w = dw; last.h = dh;
+    } else {
+        damage = last;
+    }
+    {
+        const int dpitch = surf->pitch / 4;
+        Uint32 *dbase = (Uint32 *)surf->pixels + (size_t)dy * dpitch + dx;
+        int prev_sy = -1;
+        Uint32 *prev_row = NULL;
+        for (y = 0; y < dh; y++) {
+            const int sy = (int)(((Sint64)y * h) / dh);
+            Uint32 *drow = dbase + (size_t)y * dpitch;
+            if (sy == prev_sy && prev_row) {
+                SDL_memcpy(drow, prev_row, sizeof(Uint32) * dw);
+            } else {
+                const Uint32 *srow = argb + (size_t)sy * pitch_px;
+                for (int x = 0; x < dw; x++) {
+                    const Uint32 p = srow[xmap[x]];
+                    drow[x] = (p & 0xFF00FF00u) | ((p >> 16) & 0xFFu) | ((p & 0xFFu) << 16);
+                }
+            }
+            prev_sy = sy;
+            prev_row = drow;
+        }
+    }
+    /* Overlays sit inside the frame's rectangle (the next frame repaints it
+     * when they go away); one reaching outside widens this frame's damage. */
+    for (int i = 0; i < nov; i++) {
+        SDL_Rect r;
+        PS5_DrawOverlay(surf, &ov[i]);
+        r.x = ov[i].dx; r.y = ov[i].dy; r.w = ov[i].dw; r.h = ov[i].dh;
+        if (SDL_IntersectRect(&r, &full, &r)) {
+            SDL_Rect in;
+            SDL_UnionRect(&damage, &r, &damage);
+            if (!SDL_IntersectRect(&r, &last, &in) || !SDL_RectEquals(&in, &r)) {
+                PS5_overlay_outside = 1;
+            }
+        }
+    }
+    t1 = SDL_GetPerformanceCounter();
+    idx = PS5_frame_id % 2;
+    PS5_Tilemap_Blit(dd->tmap, surf->pixels, surf->pitch / 4, dd->vbuf[idx].data, idx,
+                     &damage, 1, 0, 0);
+    t2 = SDL_GetPerformanceCounter();
+    if (sceVideoOutSubmitFlip(dd->handle, idx, 1, PS5_frame_id) ||
+        sceKernelWaitEqueue(dd->evt_queue, &evt, 1, &junk, 0)) {
+        PS5_PresentUnlock();
+        return -1;
+    }
+    PS5_frame_id++;
+    t3 = SDL_GetPerformanceCounter();
+    PS5_present_stats.frames++;
+    PS5_present_stats.scale_ticks += t1 - t0;
+    PS5_present_stats.blit_ticks += t2 - t1;
+    PS5_present_stats.wait_ticks += t3 - t2;
+    PS5_present_stats.w = dw;
+    PS5_present_stats.h = dh;
+    PS5_PresentUnlock();
+    return 0;
+}
+
+DECLSPEC double SDLCALL SDL_PS5_TakeScaleMs(void)
+{
+    /* Called right before SDL_PS5_TakePresentStats(), which resets it. */
+    return PS5_present_stats.scale_ticks / ((double)SDL_GetPerformanceFrequency() / 1000.0);
+}
+
 #endif /* SDL_VIDEO_DRIVER_PS5 */
 
