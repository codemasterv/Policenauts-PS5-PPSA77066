+/* psxrecomp PS5 port: present timing (tilemap blit vs vblank wait). */
+static struct {
+    Uint64 frames, blit_ticks, wait_ticks, scaled, scale_ticks;
+    int w, h;
+} PS5_present_stats;
+
+/* One flip at a time: SDL's own framebuffer present (main thread) and
+ * SDL_PS5_PresentPixels() (a title's present thread) share both buffers. */
+static SDL_mutex *PS5_present_mutex; /* created in PS5_VideoInit */
+static Uint32 PS5_frame_id;
+static void PS5_PresentLock(void) { if (PS5_present_mutex) SDL_LockMutex(PS5_present_mutex); }
+static void PS5_PresentUnlock(void) { if (PS5_present_mutex) SDL_UnlockMutex(PS5_present_mutex); }
+
+DECLSPEC void SDLCALL SDL_PS5_TakePresentStats(Uint64 *frames, double *blit_ms, double *wait_ms,
+                                               int *w, int *h)
+{
+    const double f = (double)SDL_GetPerformanceFrequency() / 1000.0;
+    *frames = PS5_present_stats.frames;
+    *blit_ms = PS5_present_stats.blit_ticks / f;
+    *wait_ms = PS5_present_stats.wait_ticks / f;
+    *w = PS5_present_stats.w;
+    *h = PS5_present_stats.h;
+    SDL_zero(PS5_present_stats);
+}
